+    # OPAL (OPAL=1): a coding agent rewrites the optimizers while the model trains. The schedule above becomes
+    # LambdaLR schedulers with the same values, which the starting program follows and the agent can take over.
+    stepper = None
+    if os.environ.get("OPAL") == "1":
+        import opal
+
+        def lr_lambda(step, cooldown_frac=0.7):
+            progress = min(step, train_steps - 1) / train_steps
+            return 1.0 if progress < 1 - cooldown_frac else (1 - progress) / cooldown_frac
+
+        schedulers = [torch.optim.lr_scheduler.LambdaLR(opt, lr_lambda) for opt in optimizers]
+        stepper = opal.wrap(
+            optimizers,
+            model,
+            scheduler=schedulers,
+            total_steps=train_steps,
+            goal=("GPT language model (12 layers, width 768, 162M parameters) trained from scratch on FineWeb web text "
+                  f"(GPT-2 tokens) for {train_steps} updates of 524,288 tokens on {dist.get_world_size()} GPUs; judged "
