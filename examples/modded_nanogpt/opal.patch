+            backend=os.environ.get("OPAL_BACKEND", "claude"),
+            max_cost_usd=float(os.environ["OPAL_MAX_COST_USD"]) if "OPAL_MAX_COST_USD" in os.environ else None,
+            decisions=int(os.environ.get("OPAL_DECISIONS", "50")),
+            every=int(os.environ.get("OPAL_EVERY", "50")),
+        )
+
 
